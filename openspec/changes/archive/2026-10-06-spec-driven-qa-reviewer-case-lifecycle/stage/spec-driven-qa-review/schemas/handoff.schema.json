{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec-Driven QA Handoff",
  "type": "object",
  "required": ["document_type", "handoff_contract_version", "case_id", "source_revision", "recipient_role", "workflow"],
  "properties": {
    "document_type": {"const": "spec-driven-qa-handoff"},
    "handoff_contract_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^QA-[0-9]{4,}$"},
    "generated_at": {"type": "string"},
    "source_revision": {"type": "string", "minLength": 1},
    "recipient_role": {"type": "string", "minLength": 1},
    "workflow": {"enum": ["author-response", "reviewer-verification", "adjudication"]},
    "status": {"type": "string"},
    "current_cycle": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}

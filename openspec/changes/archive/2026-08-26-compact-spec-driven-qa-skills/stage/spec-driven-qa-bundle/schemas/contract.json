{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "case_revision", "case_status", "next_action", "findings", "evidence", "digest_target"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "case_revision": {"type": "integer", "minimum": 0},
    "case_status": {"enum": ["open", "needs-response", "verification-in-progress", "closed", "blocked"]},
    "next_action": {"type": "string", "minLength": 1},
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "classification", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^QA-[0-9]+-F[0-9]+$"},
          "classification": {"enum": ["critical", "high", "medium", "low"]},
          "status": {"enum": ["open", "accepted", "fix-submitted", "fixed-and-verified", "risk-accepted", "not-applicable"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["verified", "unverified", "evidence-gap", "risk-accepted", "fixed-and-verified"]}
        }
      }
    },
    "digest_target": {
      "type": "object",
      "required": ["paths"],
      "properties": {"paths": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    }
  },
  "additionalProperties": true
}

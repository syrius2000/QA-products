{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPlanInput",
  "type": "object",
  "required": [
    "operation_id",
    "actor_id",
    "role",
    "invocation_id",
    "previous_handoff_id",
    "expected_case_revision",
    "plan_reviews"
  ],
  "properties": {
    "operation_id": {"type": "string"},
    "actor_id": {"type": "string"},
    "role": {"type": "string", "enum": ["reviewer"]},
    "invocation_id": {"type": "string"},
    "previous_handoff_id": {"type": "string"},
    "expected_case_revision": {"type": "integer", "minimum": 1},
    "plan_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "outcome", "rationale"],
        "properties": {
          "finding_id": {"type": "string"},
          "outcome": {
            "type": "string",
            "enum": [
              "plan-accepted",
              "plan-accepted-with-comments",
              "plan-revision-required",
              "finding-withdrawn",
              "converted-to-suggestion",
              "not-applicable",
              "owner-decision-required"
            ]
          },
          "rationale": {"type": "string"},
          "comments": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence": {
      "type": "array"
    }
  }
}

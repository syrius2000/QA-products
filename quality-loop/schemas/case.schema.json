{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quality-loop/case.schema.json",
  "title": "Quality Loop Case",
  "type": "object",
  "required": [
    "schema_version",
    "case_metadata",
    "baseline",
    "implementation_authorization",
    "change_observation",
    "findings",
    "evidence",
    "plans",
    "plan_reviews",
    "responses",
    "verifications",
    "final_risk_assessments",
    "adjudications",
    "events",
    "handoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_metadata": {
      "type": "object",
      "required": ["case_id", "revision", "status", "owner", "cycle_count", "cycle_limit", "created_at", "updated_at"]
    },
    "baseline": {
      "type": "object",
      "required": [
        "purpose",
        "intended_use",
        "risk_context",
        "requirements",
        "acceptance_criteria",
        "targets",
        "target_revision"
      ],
      "properties": {
        "purpose": {"type": "string"},
        "intended_use": {
          "type": "object",
          "properties": {
            "users": {"type": "string"},
            "environment": {"type": "string"},
            "operational_context": {"type": "string"}
          }
        },
        "risk_context": {
          "type": "object",
          "required": ["criticality"],
          "properties": {
            "criticality": {"type": "string", "enum": ["low", "medium", "high", "regulated"]},
            "safety_impact": {"type": "string"},
            "data_integrity_impact": {"type": "string"},
            "security_context": {"type": "string"}
          }
        },
        "requirements": {"type": "array"},
        "acceptance_criteria": {"type": "array"},
        "exclusions": {"type": "array"},
        "targets": {"type": "array"},
        "target_revision": {"type": "string"}
      }
    },
    "implementation_authorization": {"type": "object"},
    "change_observation": {"type": "object"},
    "findings": {"type": "array"},
    "evidence": {"type": "array"},
    "plans": {"type": "array"},
    "plan_reviews": {"type": "array"},
    "responses": {"type": "array"},
    "verifications": {"type": "array"},
    "final_risk_assessments": {"type": "array"},
    "adjudications": {"type": "array"},
    "events": {"type": "array"},
    "handoff": {"type": "object"}
  },
  "additionalProperties": false
}
